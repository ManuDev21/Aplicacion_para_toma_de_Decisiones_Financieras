# URL base de la API. Sin valores reales en el repo.
# En local con FastAPI:  http://localhost:8000
# En producción:         la Lambda Function URL que imprime SAM al desplegar.
#
# En AWS Amplify esta variable NO se lee de este archivo: se define en la
# consola de Amplify (App settings -> Environment variables) como VITE_API_URL.
VITE_API_URL=http://localhost:8000
